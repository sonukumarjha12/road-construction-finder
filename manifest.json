{
  "manifest_version": 3,
  "name": "Road Construction Finder",
  "version": "1.0.0",
  "description": "AI-powered road construction research assistant using Gemini.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Road Construction Finder"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}